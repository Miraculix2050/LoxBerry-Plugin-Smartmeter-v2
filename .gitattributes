* text=auto

*.sh    text eol=lf
*.cgi   text eol=lf
*.pl    text eol=lf
*.pm    text eol=lf
*.cfg   text eol=lf
*.ini   text eol=lf
*.html  text eol=lf
*.php   text eol=lf
*.js    text eol=lf
*.json  text eol=lf
*.jsonc text eol=lf

daemon/*           text eol=lf
uninstall/*        text eol=lf
sudoers/*          text eol=lf
dpkg/apt*          text eol=lf
cron/*             text eol=lf

*.png binary
*.zip binary

# Keep existing document diff behavior.
*.cs   diff=csharp
*.doc  diff=astextplain
*.DOC  diff=astextplain
*.docx diff=astextplain
*.DOCX diff=astextplain
*.dot  diff=astextplain
*.DOT  diff=astextplain
*.pdf  diff=astextplain
*.PDF  diff=astextplain
*.rtf  diff=astextplain
*.RTF  diff=astextplain

# Exclude development-only files from release archives.
.gitattributes export-ignore
.gitignore export-ignore
.github/ export-ignore
.codex/ export-ignore
AGENTS.md export-ignore
docs/development/ export-ignore
docs/development/** export-ignore
Tests/ export-ignore
tests/ export-ignore
test/ export-ignore
tools/ export-ignore
release.cfg export-ignore
prerelease.cfg export-ignore
